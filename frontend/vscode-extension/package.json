{
  "name": "awscheppu-ai",
  "displayName": "AWS Cheppu",
  "description": "Voice-controlled AWS infrastructure management",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "awscheppu.openChat",
        "title": "AWS Cheppu: Open Chat",
        "icon": "$(mic)"
      }
    ],
    "keybindings": [
      {
        "command": "awscheppu.openChat",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "awscheppu.openChat",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
