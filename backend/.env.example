# ═══════════════════════════════════════════════════════════
# AWS Cheppu — Environment Variables
# Copy this file to backend/.env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── REQUIRED for AWS tools (EC2, S3, IAM, etc.) ───────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# ── LLM (pick ONE path) ───────────────────────────────────
# Path A: Anthropic API direct (easiest for local testing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Path B: AWS Bedrock (leave ANTHROPIC_API_KEY empty to use this)
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Optional separate Bedrock credentials:
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_REGION=us-east-1

# ── Transcription (pick ONE) ──────────────────────────────
# Options: mock | whisper | sarvam | gemini | transcribe
# Start with "mock" if you only want text chat (no mic)
TRANSCRIPTION_BACKEND=mock

# If TRANSCRIPTION_BACKEND=sarvam (best for Hindi voice input)
SARVAM_API_KEY=

# If TRANSCRIPTION_BACKEND=whisper
OPENAI_API_KEY=

# If TRANSCRIPTION_BACKEND=gemini
GEMINI_API_KEY=

# If TRANSCRIPTION_BACKEND=transcribe (Amazon Transcribe)
# VOICEOPS_AUDIO_BUCKET=your-s3-bucket-name

# ── TTS (Amazon Polly) ────────────────────────────────────
# Needs AWS credentials above. If Polly fails, chat still works (text only).
TTS_ENABLED=true
POLLY_VOICE_ID=Ruth

# ── Bolna Phone Alerts (optional) ─────────────────────────
# Without these, call_user runs in MOCK mode (logs only, no real call)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional default phone (E.164 format). UI phone field overrides this.
# BOLNA_PHONE_NUMBER=+919876543210
# BOLNA_BASE_URL=https://api.bolna.ai

# ── Server ────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=info
